      "updated": 1784561912741,
      "link": null,
      "text": "+ handleUpdate(raw)      <- receives Telegram webhook JSON\n+ parseCommand(text)     <- extracts /cmd + args\n+ validateUser(chatId)   <- checks: does user exist?\n+ authenticate(user,cmd) <- checks: is user allowed?\n+ dispatch(user,cmd,args)<- routes to correct service\n+ rateLimit(user)         <- prevents spam (>N/cmds per min)",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "index": "aI",
      "frameId": null,
      "roundness": null,
      "locked": false,
      "containerId": null,
      "originalText": "+ handleUpdate(raw)      <- receives Telegram webhook JSON\n+ parseCommand(text)     <- extracts /cmd + args\n+ validateUser(chatId)   <- checks: does user exist?\n+ authenticate(user,cmd) <- checks: is user allowed?\n+ dispatch(user,cmd,args)<- routes to correct service\n+ rateLimit(user)         <- prevents spam (>N/cmds per min)",
      "autoResize": true,
      "lineHeight": 1.25
    },
