generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionProvider {
  GOOGLE
}

enum NotificationStyle {
  COMPACT
  DETAILED
}

enum ConnectionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
}

model User {
  id                 String  @id @default(ulid())
  telegramChatId     String  @unique
  activeConnectionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections Connection[]
  settings    UserSettings?

  activeConnection Connection? @relation("ActiveConnection", fields: [activeConnectionId], references: [id], onDelete: SetNull)
}

model Connection {
  id                String             @id @default(ulid())
  userId            String
  provider          ConnectionProvider @default(GOOGLE)
  providerAccountId String
  email             String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime
  status            ConnectionStatus   @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeFor User? @relation("ActiveConnection")

  @@unique([userId, provider, providerAccountId])
}

model UserSettings {
  id                 String            @id @default(ulid())
  userId             String            @unique
  checkIntervalHours Int               @default(4)
  notificationStyle  NotificationStyle @default(COMPACT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
